#!/usr/bin/env bash
# hfctl — деплой и управление hipfire-сервером (Strix Halo / gfx11xx) на
# Ubuntu/Debian одной командой. Копируется ЦЕЛЫМ ФАЙЛОМ на целевую машину и
# запускается ОТ СВОЕГО ИМЕНИ (не root; sudo применяется точечно):
#
#   scp hfctl user@host: && ssh user@host 'bash hfctl install'
#
# Команды:
#   install [--profile P] [--port N] [--bind A] [--models-dir D] [--no-autostart]
#   use <profile>                — переключить профиль (+recreate, заменяет
#                                  конфиг автозапуска; недостающие модели
#                                  докачиваются с вопросом)
#   status [--json] | logs [-f] [-n N]
#   on | off                     — автозапуск вкл / выкл (off = стоп + снятие
#                                  с автозапуска; файлы/модели/образ целы)
#   uninstall [--purge-models] [--purge-image]
#
# Профили:
#   27b-single (по умолчанию) — 27B в обеих квантах (mq4 default), singleton+DFlash
#   27b-slots                 — те же модели, multi_slot 2×262144 (HOL-изоляция)
#
# Скрытые алиасы (совместимость): up|down|mode single|slots|autostart|noautostart.
#
# Идемпотентен: повторный install доводит существующую инсталляцию до
# целевого состояния. Переопределяемые переменные — ниже.
set -euo pipefail

# ── конфигурация (env переопределяет) ───────────────────────────────────────
IMAGE="${HFCTL_IMAGE:-ghcr.io/warpfront/hipfire:0.4.5}"
STACK_DIR="${HFCTL_DIR:-$HOME/hipfire}"          # всё инсталляция здесь (compose, .env, бинарь)
MODELS_BASE="${HFCTL_MODELS:-$STACK_DIR/models}" # база моделей; внутри — каталог-сет на профиль
MODELS_DIR="$MODELS_BASE/27b"                    # маунт; пересчитывается set_models_dir()
PORT="${HFCTL_PORT:-11435}"
BIND="${HFCTL_BIND:-0.0.0.0}"                    # 0.0.0.0 = LAN без ключа; 127.0.0.1 = локально
# ВАЖНО: в контейнер models монтируется на /home/hipfire/.hipfire/models —
# HIPFIRE_DFLASH_DRAFT указывается КОНТЕЙНЕРНЫМ путём, не хостовым.
DRAFT_FILE="/home/hipfire/.hipfire/models/qwen38-27b-dflash-mq4.hfq"
SLOTS="${HFCTL_SLOTS:-2}"                        # слотов в 27b-slots (4×262144 не влезает в OOM-guard)
CONTAINER=hipfire_hipfire_1
UNIT_NAME=hipfire-compose
STOP_MARKER="$STACK_DIR/.hfctl-stopped"   # явная остановка: вотчдог не встаёт
SELF="$(readlink -f "$0")"
MAX_SEQ=262144
MEMLOCK=1318060032

# ── профили ─────────────────────────────────────────────────────────────────
# Формат: default_model|all_models (пробел)|draft_tag ('-' = нет)|min_ram_gib|описание
# Канонические id — spec/hfctl.md §5.
PROFILE_LIST="27b-single 27b-slots flash-multi"
profile_27b_single="qwen3.8:27b-mq4-xts|qwen3.8:27b-mq4-xts qwen3.8:27b-mq6-xt|qwen3.8:27b-draft-mq4|58|singleton+DFlash (максимум соло-скорости)"
profile_27b_slots="qwen3.8:27b-mq4-xts|qwen3.8:27b-mq4-xts qwen3.8:27b-mq6-xt|qwen3.8:27b-draft-mq4|58|multi_slot ${SLOTS}×${MAX_SEQ} (HOL-изоляция; −25% агрегат)"
profile_flash_multi="qwen3.8:flash-next-mq4-xts|qwen3.8:flash-next-mq4-xts|-|80|Flash-Next mq4-xts, VMM fn-lanes (настоящий батчинг; требует ≥80 GiB пула)"
PROFILE_DEFAULT=27b-single
# порог RAM-гейта flash проверяется по field 4; 80 = 72 (мин. реестра) + запас
# (lane store + OS); калибруется на 128 GB-машине (spec/plan.md этап 4).

profile_field() {  # profile_field <id> <N> — N-е поле профиля (1-based, '|')
  local name="profile_$(echo "$1" | tr '-' '_')" v
  v="${!name:-}"
  [ -n "$v" ] || return 1
  echo "$v" | cut -d'|' -f"$2"
}
resolve_profile() {  # нормализация алиасов → канонический id; 1 если неизвестно
  case "$1" in
    27b-single|single|mq6|mq4) echo 27b-single ;;
    27b-slots|slots)           echo 27b-slots ;;
    flash-multi|flash|flash-next|multi) echo flash-multi ;;
    *) return 1 ;;
  esac
}

# ── гейты профиля (spec §6): отказ ДО скачивания, с цифрами ─────────────────
ram_pool_gib() {  # весь доступный пул (APU: MemTotal; iGPU делит LPDDR с ОС)
  awk '/MemTotal/{printf "%d", $2/1048576}' /proc/meminfo
}
profile_gate() {  # profile_gate <id> — RAM-гейт; die с цифрами при отказе
  local prof="$1" need have
  if [ "${HFCTL_FORCE:-}" = 1 ] || [ "${FORCE_GATE:-}" = 1 ]; then
    need=$(profile_field "$prof" 4); have=$(ram_pool_gib)
    [ "$have" -ge "$need" ] || warn "--force: RAM-гейт обойдён (нужно ≥${need} GiB, есть ${have}) — движок может отказать в загрузке"
    return 0
  fi
  need=$(profile_field "$prof" 4); have=$(ram_pool_gib)
  [ "$have" -ge "$need" ] || {
    echo "ERROR: профиль $prof требует ≥${need} GiB единого пула памяти" >&2
    case "$prof" in
      flash-multi) echo "       (flash-next mq4-xts: 70.9 GB резидентно целиком;" >&2
                   echo "        offload на APU не добавляет ёмкости — это та же память;" >&2
                   echo "        + lane store для батчинга)" >&2 ;;
    esac
    echo "       На этой машине: ${have} GiB. Доступные профили: $(profile_avail_list)" >&2
    exit 1
  }
}
# какие профили проходят RAM-гейт на этой машине (для текстов отказа и doctor)
profile_avail_list() {
  local p out=""
  for p in $PROFILE_LIST; do
    [ "$(ram_pool_gib)" -ge "$(profile_field "$p" 4)" ] && out="$out $p"
  done
  echo "${out:-—}"
}

# ── каталоги моделей по сетам (изоляция профилей: сервер видит только свой
# сет → запрос с чужим model получает 404 вместо молчаливого swap) ───────────
model_set() { case "$1" in flash-multi) echo flash ;; *) echo 27b ;; esac; }
set_models_dir() { MODELS_DIR="$MODELS_BASE/$(model_set "$1")"; mkdir -p "$MODELS_DIR"; }
migrate_models() {  # плоский models/ (v1/v2) → подкаталоги-сеты
  [ -d "$MODELS_BASE" ] || return 0
  local f moved=0
  for f in "$MODELS_BASE"/*; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
      *flash-next*) mkdir -p "$MODELS_BASE/flash"; mv "$f" "$MODELS_BASE/flash/"; moved=1 ;;
      *)            mkdir -p "$MODELS_BASE/27b";   mv "$f" "$MODELS_BASE/27b/";   moved=1 ;;
    esac
  done
  [ "$moved" = 1 ] && log "миграция моделей: разложены по сетам (27b/, flash/) — маунт видит только сет активного профиля"
  return 0
}

log()  { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFATAL:\033[0m %s\n' "$*" >&2; exit 1; }

CF=( -f compose.yml -f compose.halo.yml -f compose.local.yml )
compose() { ( cd "$STACK_DIR" && podman compose "${CF[@]}" "$@" ); }
env_val() { [ -f "$STACK_DIR/.env" ] && grep -E "^$1=" "$STACK_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true; }
cur_profile() { local p; p=$(env_val HFCTL_PROFILE); echo "${p:-$PROFILE_DEFAULT}"; }
cur_model()   { env_val HIPFIRE_MODEL || echo "$(profile_field "$(cur_profile)" 1)"; }

# ── префлайт и хост-подготовка ──────────────────────────────────────────────
preflight() {
  [ "$(id -u)" != 0 ] || die "не запускай от root — работай от своего имени (sudo hfctl не нужен)"
  local id
  id=$(. /etc/os-release && echo "$ID")
  case "$id" in ubuntu|debian) ;; *) die "дистрибутив '$id' не поддерживается (нужен Ubuntu/Debian)" ;; esac
  [ -e /dev/kfd ] || die "/dev/kfd нет: AMD GPU не виден (проверь драйвер amdgpu)"
  local mem_kb; mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
  [ "$mem_kb" -ge 57671680 ] || warn "RAM ${mem_kb}kB < ~58 GiB: 27B@262K может не влезть (нужна Halo 60 GiB+)"
  if ! command -v podman >/dev/null || ! command -v podman-compose >/dev/null; then
    log "установка podman + podman-compose (sudo точечно)"
    sudo apt-get update -qq && sudo apt-get install -y -qq podman podman-compose
  fi
  command -v curl >/dev/null || sudo apt-get install -y -qq curl
  # группа render для /dev/kfd rootless
  if ! id -nG | grep -qw render; then
    log "добавляю $USER в группу render (sudo точечно)"
    sudo usermod -aG render "$USER"
    warn "группа применится только после перезахода. Выйди и зайди снова, затем повтори install."
    exit 42
  fi
  # memlock для NPU-trunk (limits.d; требует ребута/пересоздания сессий)
  local lim="/etc/security/limits.d/99-hipfire-memlock.conf"
  if [ ! -f "$lim" ]; then
    log "пишу $lim (memlock $MEMLOCK)"
    echo "$USER soft memlock $MEMLOCK" | sudo tee "$lim" >/dev/null
    echo "$USER hard memlock $MEMLOCK" | sudo tee -a "$lim" >/dev/null
    if [ "$(ulimit -Hl)" != "unlimited" ] && [ "$(ulimit -Hl)" -lt "$MEMLOCK" ]; then
      warn "текущая сессия ещё с memlock=$(ulimit -Hl). Требуется ребут (или перезаход+сервис-менеджер). Повтори install после ребута."
      exit 42
    fi
  fi
  # linger: сервер должен жить без активного логина и при boot
  if [ "$(loginctl show-user "$USER" --property=Linger 2>/dev/null | cut -d= -f2)" != "yes" ]; then
    log "включаю linger для $USER (сервер переживает logout и стартует при boot)"
    sudo loginctl enable-linger "$USER"
  fi
}

# ── неинтерактив: вопросы только при TTY (--yes — авто-да) ──────────────────
ASSUME_YES="${HFCTL_YES:-}"
ask() {  # ask <question> — 0 при да; при не-TTY и без --yes — отказ (безопасно)
  [ "$ASSUME_YES" = 1 ] && return 0
  if [ ! -t 0 ]; then echo "(неинтерактивный режим: авто-нет; повтори с --yes)"; return 1; fi
  local a; read -r -p "$1" a; [ "$a" = y ]
}

# ── файлы стека (встраиваю официальные compose-файлы hipfire 0.4.5) ─────────
ensure_symlink() {  # ~/.local/bin/hfctl → бинарь в стеке (вариант 2: стек = истина)
  local bin_dir="$HOME/.local/bin"
  mkdir -p "$bin_dir"
  ln -sfn "$STACK_DIR/hfctl" "$bin_dir/hfctl"
}
write_stack_files() {
  log "стек в $STACK_DIR"
  mkdir -p "$STACK_DIR" "$MODELS_DIR"
  # бинарь живёт В СТЕКЕ (источник истины; юниты ссылаются на него).
  # Копируем только при отсутствии (обновление — install.sh / 'hfctl upgrade'):
  # перезапись здесь могла бы откатить свежий install.sh-бинарь старым.
  if [ ! -f "$STACK_DIR/hfctl" ] && [ "$SELF" != "$STACK_DIR/hfctl" ]; then
    install -m 0755 "$SELF" "$STACK_DIR/hfctl"
  fi
  ensure_symlink

  # compose.yml — дословно из репозитория hipfire 0.4.5 (без monitoring-профилей:
  # они ссылаются на каталоги репо, которые hfctl не разворачивает).
  cat > "$STACK_DIR/compose.yml" <<'COMPOSE'
# hipfire compose stack (upstream hipfire 0.4.5, monitoring profiles trimmed).
name: hipfire

x-hipfire-engine: &hipfire-engine
  image: ${HIPFIRE_IMAGE:-ghcr.io/warpfront/hipfire:latest}
  devices:
    - /dev/kfd
    - /dev/dri
  group_add:
    - video
    - render
  security_opt:
    - seccomp=unconfined
  annotations:
    run.oci.keep_original_groups: "1"
  environment:
    - HIPFIRE_MODEL=${HIPFIRE_MODEL:-qwen3.8:27b-mq4-xts}
    - HIPFIRE_SERVE_UI=${HIPFIRE_UI:-0}
    - HIPFIRE_SERVE_ARGS=${HIPFIRE_SERVE_ARGS:-}
    - HF_TOKEN
    - HIPFIRE_DEVICES
    - ROCR_VISIBLE_DEVICES
  volumes:
    - ${HIPFIRE_MODELS_PATH:-hipfire-models}:/home/hipfire/.hipfire/models
    - hipfire-config:/home/hipfire/.hipfire
    - hipfire-kernels:/var/cache/hipfire

services:
  hipfire-init:
    <<: *hipfire-engine
    command: pull --yes ${HIPFIRE_MODEL:-qwen3.8:27b-mq4-xts}
    restart: "no"

  hipfire:
    <<: *hipfire-engine
    command: ["serve"]
    init: true
    restart: unless-stopped        # переподнимание при краше — за podman
    depends_on:
      hipfire-init:
        condition: service_completed_successfully
    ports:
      - ${HIPFIRE_BIND:-127.0.0.1}:${HIPFIRE_PORT:-11435}:11435
    healthcheck:
      test:
        - CMD-SHELL
        - |
          body=$$(curl -fsS http://127.0.0.1:11435/health) && ! printf '%s' "$$body" | grep -Eq '"loading_model"[[:space:]]*:[[:space:]]*"'
      interval: 15s
      timeout: 5s
      retries: 4
      start_period: 15m

volumes:
  hipfire-models:
  hipfire-config:
  hipfire-kernels:
COMPOSE

  cat > "$STACK_DIR/compose.halo.yml" <<'HALO'
# Strix Halo (XDNA2 NPU): /dev/accel + memlock (upstream hipfire 0.4.5).
services:
  hipfire-init:
    devices:
      - /dev/accel
    ulimits:
      memlock:
        soft: 1318060032
        hard: 1318060032
  hipfire:
    devices:
      - /dev/accel
    ulimits:
      memlock:
        soft: 1318060032
        hard: 1318060032
HALO

  # compose.local.yml: DFlash-wiring для профилей с draft (mq6-xt не объявляет
  # sidecar в реестре; MQ4 draft — рекомендованный контроллер). Профили без
  # draft (flash-multi: native MTP) получают пустой env = DFlash выключен.
  local prompt_vol="" draft_env=""
  [ -d "$STACK_DIR/benchmarks/prompts" ] && prompt_vol="
    volumes:
      - ./benchmarks/prompts:/prompts:ro"
  local cur_draft; cur_draft=$(profile_field "$(cur_profile)" 3)
  [ "$cur_draft" != "-" ] && [ -n "$cur_draft" ] && draft_env="      HIPFIRE_DFLASH_DRAFT: $DRAFT_FILE"
  cat > "$STACK_DIR/compose.local.yml" <<EOF
services:
  hipfire:$prompt_vol
    environment:
$draft_env
EOF
}

# ── .env: канон профиля + параметры (порт/bind/путь сохраняем существующие) ─
write_env() {  # write_env <profile_id> <default_model>
  local prof="$1" model="$2"
  cat > "$STACK_DIR/.env" <<EOF
# hfctl (сгенерировано; после ручной правки — hfctl up)
HFCTL_PROFILE=$prof
HIPFIRE_MODEL=$model
HIPFIRE_PORT=$PORT
HIPFIRE_BIND=$BIND
HIPFIRE_UI=0
HIPFIRE_SERVE_ARGS=
HIPFIRE_MODELS_PATH=$MODELS_DIR
HIPFIRE_IMAGE=$IMAGE
COMPOSE_FILE=compose.yml:compose.halo.yml:compose.local.yml
EOF
}

# ── конфиг движка (volume через compose run — volume проекты гарантированно) ─
cfgset() {  # cfgset <key> <value>
  compose run --rm --no-deps hipfire hipfire config set "$1" "$2" </dev/null 2>&1 | tail -1 || true
}
apply_profile() {  # apply_profile <id> — ключи движка из таблицы профилей
  local prof="$1"
  log "профиль движка: $prof ($(profile_field "$prof" 5))"
  cfgset memory.max_seq "$MAX_SEQ"
  cfgset memory.session_cache_disk_bytes 34359738368
  case "$prof" in
    27b-slots)
      cfgset speculation.dflash on
      cfgset serve.multi_slot true
      cfgset serve.multi_slot_slots "$SLOTS"
      cfgset serve.multi_slot_ctx "$MAX_SEQ"
      cfgset serve.continuous_batch_size 1
      cfgset serve.vmm_batch false
      cfgset serve.batch_nonexact false
      ;;
    flash-multi)
      # VMM continuous batching (fn-lanes, Qwen4): spec/hfctl.md §5.
      # При отказе lanes движок сам печатает 'qwen4 lanes refused: … —
      # fallback to sequential' и живёт serial (проверка в check_route).
      cfgset speculation.dflash off          # у flash native MTP; роут решает движок
      cfgset serve.multi_slot false
      cfgset serve.multi_slot_slots 2
      cfgset serve.multi_slot_ctx "$MAX_SEQ"
      cfgset serve.continuous_batch_size 4
      cfgset serve.vmm_batch true
      cfgset serve.batch_sampled true
      ;;
    *)  # 27b-single (default)
      cfgset speculation.dflash on
      cfgset serve.multi_slot false
      cfgset serve.multi_slot_slots 4
      cfgset serve.multi_slot_ctx "$MAX_SEQ"
      cfgset serve.continuous_batch_size 4
      cfgset serve.vmm_batch true
      cfgset serve.batch_nonexact true
      ;;
  esac
}

wait_health() {  # wait_health [timeout_sec]
  local t="${1:-900}" i=0
  log "жду готовности (до ${t}с)"
  while [ "$i" -lt "$t" ]; do
    local body
    if body=$(curl -fsS -m 5 "http://127.0.0.1:$PORT/health" 2>/dev/null) && \
       printf '%s' "$body" | python3 -c 'import json,sys
d=json.load(sys.stdin)
sys.exit(0 if d.get("status")=="ok" and d.get("model") and not d.get("loading_model") else 1)' 2>/dev/null; then
      printf '%s\n' "$body" | head -c 300; echo
      echo "HEALTHY после ${i}с"
      return 0
    fi
    sleep 5; i=$((i+5))
    if [ "$i" -ge 120 ] && podman logs --since 10m "$CONTAINER" 2>&1 | grep -q "pre-warm failed"; then
      warn "pre-warm упал — ранний выход, последние логи:"
      podman logs --tail 25 "$CONTAINER" 2>&1 | tail -25 || true
      return 1
    fi
  done
  warn "не здоров через ${t}с — последние логи:"
  podman logs --tail 30 "$CONTAINER" 2>&1 | tail -30 || true
  return 1
}

smoke() {
  log "смоук: 2 запроса"
  local ok=1 prompt
  for prompt in "Ответь ровно: ок" "Напиши одну строку кода на python: hello world"; do
    local out
    out=$(curl -fsS -m 120 "http://127.0.0.1:$PORT/v1/chat/completions" \
      -H 'Content-Type: application/json' \
      -d "{\"model\":\"$(cur_model)\",\"messages\":[{\"role\":\"user\",\"content\":\"$prompt\"}],\"max_tokens\":200,\"reasoning_effort\":\"none\"}" 2>/dev/null) || { ok=0; continue; }
    printf '%s' "$out" | python3 -c 'import json,sys; d=json.load(sys.stdin); c=d["choices"][0]["message"]["content"]; print("ответ:", (c or "")[:60].strip() or "(ПУСТО)"); sys.exit(0 if (c or "").strip() else 1)' || ok=0
  done
  [ "$ok" = 1 ] || die "смоук не прошёл — смотри 'hfctl logs'"
  echo "SMOKE: OK"
}

check_route() {  # check_route <profile> — фактический роут (spec §7): движок
  # может вежливо деградировать (vmm lanes refused → serial) — показываем реальность.
  # Источники: логи (fn-lanes staged / lanes refused — авторитетно) + health.
  local prof="$1" clog staged refused
  clog=$(podman logs --tail 400 "$CONTAINER" 2>&1 || true)
  # ВАЖНО: '|| true' обязателен — под set -e+pipefail grep без совпадения
  # (нормальный случай: lanes приняты, отказа нет) молча убивал весь скрипт
  staged=$(printf '%s' "$clog" | grep -oE "fn-lanes staged: topology=[a-z]+ lanes=[0-9]+[^\"]*spec=[a-z0-9]+" | tail -1) || true
  refused=$(printf '%s' "$clog" | grep -oE "qwen4 lanes refused:[^-—]*" | tail -1) || true
  case "$prof" in
    flash-multi)
      if [ -n "$staged" ]; then
        echo "lanes: $staged"
        echo "      → настоящий батчинг принят (запросы делят trunk-шаг)"
      elif [ -n "$refused" ]; then
        warn "vmm lanes ОТКАЗАНЫ: $refused — сервер работает serial (fallback)"
        warn "тексты eligible-запросов всё равно исполняются корректно (singleton)"
      else
        echo "lanes: данных нет (ни staged, ни refused в логах) — проверь 'hfctl logs'"
      fi
      ;;
    27b-slots)  echo "роут: multi_slot ($(curl -fsS -m 5 "http://127.0.0.1:$PORT/health" 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("capabilities",{}).get("mode","?"))' 2>/dev/null || echo '?'))" ;;
    *)          echo "роут: singleton+DFlash ($(
                  printf '%s' "$clog" | grep -oE "spec: [a-z0-9 ]+" | tail -1 | head -c 60))" ;;
  esac
}

pull_model() {  # pull_model <tag> — идемпотентно (sha256-верификация внутри hipfire pull)
  local tag="$1"
  log "тяну модель $tag"
  podman run --rm -v "$MODELS_DIR:/home/hipfire/.hipfire/models" "$IMAGE" \
    hipfire pull "$tag" --yes 2>&1 | tail -2
}

pull_profile_models() {  # все модели + draft профиля
  local prof="$1" tag draft
  podman image exists "$IMAGE" || podman pull "$IMAGE" >/dev/null || podman pull "$IMAGE"
  for tag in $(profile_field "$prof" 2); do
    pull_model "$tag"
  done
  draft=$(profile_field "$prof" 3)
  [ "$draft" != "-" ] && [ -n "$draft" ] && pull_model "$draft" || true
}

# ── подкоманды ──────────────────────────────────────────────────────────────
cmd_install() {
  local prof="" no_autostart=0 set_port=0 set_bind=0 set_models=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile)     prof="$2"; shift 2 ;;
      --port)        PORT="$2"; set_port=1; shift 2 ;;
      --bind)        BIND="$2"; set_bind=1; shift 2 ;;
      --models-dir)  MODELS_DIR="$2"; set_models=1; shift 2 ;;
      --no-autostart) no_autostart=1; shift ;;
      --force)       force=1; shift ;;
      --yes)         ASSUME_YES=1; shift ;;
      *) die "неизвестный флаг install: $1 (доступны: --profile ${PROFILE_LIST// /|} --port --bind --models-dir --no-autostart --yes)" ;;
    esac
  done
  # миграция v1-.env (нет HFCTL_PROFILE): сохраняем текущую модель/порт/bind/путь
  if [ -f "$STACK_DIR/.env" ] && [ -z "$(env_val HFCTL_PROFILE)" ]; then
    local old; old=$(env_val HIPFIRE_MODEL)
    if [ -n "$old" ]; then
      MODEL_DEFAULT="$old"
      warn "миграция: найден старый .env — профиль $PROFILE_DEFAULT, модель по умолчанию остаётся $old"
    fi
    local v
    v=$(env_val HIPFIRE_PORT);        [ -n "$v" ] && [ "$set_port" = 0 ]  && PORT="$v"
    v=$(env_val HIPFIRE_BIND);        [ -n "$v" ] && [ "$set_bind" = 0 ]  && BIND="$v"
    v=$(env_val HIPFIRE_MODELS_PATH); [ -n "$v" ] && [ "$set_models" = 0 ] && MODELS_BASE="$v" && set_models_dir "$prof"
  fi
  prof=$(resolve_profile "${prof:-$PROFILE_DEFAULT}") || die "неизвестный профиль '$prof' (доступны: $PROFILE_LIST)"
  FORCE_GATE="${FORCE_GATE:-}"; [ "${force:-0}" = 1 ] && FORCE_GATE=1
  profile_gate "$prof"          # RAM-гейт: отказ ДО любого скачивания (spec §6)
  # миграция плоского models/ в сеты (один раз; сохраняет скачанное)
  migrate_models
  set_models_dir "$prof"
  preflight
  write_stack_files
  # приоритет: HFCTL_MODEL > сохранённая при миграции модель > дефолт профиля
  MODEL_DEFAULT="${HFCTL_MODEL:-${MODEL_DEFAULT:-$(profile_field "$prof" 1)}}"
  write_env "$prof" "$MODEL_DEFAULT"
  log "образ $IMAGE (если ещё не локально)"
  podman image exists "$IMAGE" || podman pull "$IMAGE"
  pull_profile_models "$prof"
  compose up -d 2>&1 | tail -3
  apply_profile "$prof"
  compose up -d --force-recreate 2>&1 | tail -3
  wait_health 900
  smoke
  check_route "$prof"
  if [ "$no_autostart" = 1 ]; then
    echo "(автозапуск не включён — '--no-autostart'; включить: hfctl on)"
  else
    cmd_autostart
  fi
  log "готов. Сервер: http://$BIND:$PORT | профиль: $prof | модель по умолчанию: $(cur_model)"
  cat <<EOF

── как пользоваться ──────────────────────────────────────────────
Клиент (OpenAI-совместимый):  base_url = http://$BIND:$PORT/v1
Список моделей:  curl http://127.0.0.1:$PORT/v1/models
Проверка:
  curl http://127.0.0.1:$PORT/v1/chat/completions -H 'Content-Type: application/json' \\
    -d '{"model":"$(cur_model)","messages":[{"role":"user","content":"привет"}],"max_tokens":400,"reasoning_effort":"none"}'

Сменить профиль:  hfctl use <profile>     (${PROFILE_LIST// /|})
Остановить/вернуть: hfctl off / hfctl on   Снести: hfctl uninstall
Диагностика: hfctl doctor | hfctl status | hfctl logs -f
EOF
}

cmd_use() {
  local p="${1:-}" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      -*) die "неизвестный флаг use: $1 (доступен --force — обойти RAM-гейт)" ;;
      *) p="$1"; shift ;;
    esac
  done
  [ -n "$p" ] || die "использование: hfctl use <profile> (${PROFILE_LIST// /|})"
  [ -f "$STACK_DIR/.env" ] || die "стек не установлен — сначала 'hfctl install'"
  p=$(resolve_profile "$p") || die "неизвестный профиль '$p' (доступны: $PROFILE_LIST)"
  local prev_prof prev_model
  prev_prof=$(cur_profile); prev_model=$(cur_model)
  [ "${force:-0}" = 1 ] && FORCE_GATE=1
  profile_gate "$p"             # RAM-гейт: отказ ДО любого скачивания (spec §6)
  migrate_models                # плоский models/ (старые версии) → сеты
  set_models_dir "$p"
  # порт/bind — из текущего .env (use не трогает параметры, только профиль);
  # путь моделей: уважаем старую базу (если была нестандартная), сет — новый
  local v mb
  v=$(env_val HIPFIRE_PORT); [ -n "$v" ] && PORT="$v"
  v=$(env_val HIPFIRE_BIND); [ -n "$v" ] && BIND="$v"
  mb=$(env_val HIPFIRE_MODELS_PATH)
  if [ -n "$mb" ] && [ "$mb" != "$MODELS_DIR" ]; then
    # старый путь: если он плоский (не содержит /models/<сет>) — это база
    case "$mb" in
      */models/27b|*/models/flash) MODELS_BASE="$(dirname "$mb")" ;;
      *)                           MODELS_BASE="$mb" ;;
    esac
    set_models_dir "$p"
  fi
  preflight
  pull_profile_models "$p"
  MODEL_DEFAULT="${HFCTL_MODEL:-$(profile_field "$p" 1)}"
  write_env "$p" "$MODEL_DEFAULT"
  compose up -d 2>&1 | tail -2      # контейнеры могут быть остановлены (off)
  apply_profile "$p"
  compose up -d --force-recreate 2>&1 | tail -2
  if ! wait_health 600; then
    # движок отказал в загрузке (admission/refusal): откатываем канон на прежний
    warn "профиль $p НЕ поднялся — откат канона на $prev_prof ($prev_model)"
    write_env "$prev_prof" "$prev_model"
    return 1
  fi
  smoke
  check_route "$p"
  log "профиль $p активен (конфиг автозапуска обновлён — переживёт рестарт)"
}

cmd_up()   { rm -f "$STOP_MARKER"; hf_up_locked; wait_health 600; }
cmd_down() { touch "$STOP_MARKER"; compose stop 2>&1 | tail -2; echo "остановлен (контейнеры/файлы/образ целы; вотчдог молчит до 'hfctl up')"; }

cmd_on()  { cmd_autostart; cmd_up; }
cmd_off() {
  # Юнит oneshot контейнеры не держит (compose up -d отсоединён) — останавливаем
  # стек напрямую, иначе ExecStop не выполнится для уже завершённого юнита.
  mkdir -p "$STACK_DIR"
  compose stop >/dev/null 2>&1 || true
  touch "$STOP_MARKER"
  systemctl --user disable "$UNIT_NAME.service" "$UNIT_NAME-watchdog.timer" 2>/dev/null || true
  rm -f "$HOME/.config/systemd/user/$UNIT_NAME.service" \
        "$HOME/.config/systemd/user/$UNIT_NAME-watchdog.service" \
        "$HOME/.config/systemd/user/$UNIT_NAME-watchdog.timer"
  systemctl --user daemon-reload
  # linger глушим: в выключенном состоянии сервер не должен вскакивать при boot.
  sudo loginctl disable-linger "$USER"
  echo "ВЫКЛ: сервер остановлен, с автозапуска снят (юниты удалены, linger off)."
  echo "Файлы, модели и образ целы. Вернуть: hfctl on"
}

cmd_status() {
  local json=0; [ "${1:-}" = "--json" ] && json=1
  local prof auto wdog body
  prof=$(cur_profile)
  auto=$(systemctl --user is-enabled "$UNIT_NAME.service" 2>/dev/null || echo disabled)
  wdog=$(systemctl --user is-enabled "$UNIT_NAME-watchdog.timer" 2>/dev/null || echo disabled)
  body=$(curl -fsS -m 5 "http://127.0.0.1:$PORT/health" 2>/dev/null || echo "")
  if [ "$json" = 1 ]; then
    PROFILE="$prof" AUTO="$auto" WDOG="$wdog" python3 -c '
import json, sys, os
try: h = json.loads(sys.stdin.read())
except Exception: h = None
print(json.dumps({
  "profile": os.environ["PROFILE"],
  "autostart": os.environ["AUTO"] == "enabled",
  "watchdog": os.environ["WDOG"] == "enabled",
  "health": h,
}, ensure_ascii=False))' <<<"$body"
    return
  fi
  local hline
  hline=$(printf '%s' "$body" | python3 -c 'import json,sys
d=json.load(sys.stdin); c=d.get("capabilities",{})
st="ok" if d.get("status")=="ok" and not d.get("loading_model") else ("загрузка: "+str(d.get("loading_model")) if d.get("loading_model") else d.get("status","?"))
extra = (" | слоты: "+str(c.get("multi_slot_slots"))) if c.get("mode")=="multi-slot" else ""
print("health:", st, "| модель:", d.get("model"), "| режим:", c.get("mode")+extra)' 2>/dev/null || echo "health: сервер не отвечает")
  echo "профиль: $prof | автозапуск: $([ "$auto" = enabled ] && echo вкл || echo выкл) (watchdog: $([ "$wdog" = enabled ] && echo вкл || echo выкл))"
  echo "$hline"
  echo "── контейнеры ──"
  podman ps -a --filter "name=hipfire" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
}

cmd_logs() {
  local n=80 follow="" a
  for a in "$@"; do
    case "$a" in
      -f) follow="-f" ;;
      -n) ;;
      [0-9]*) n="$a" ;;
      -n[0-9]*) n="${a#-n}" ;;
      *) die "использование: hfctl logs [-f] [-n N]" ;;
    esac
  done
  podman logs $follow -t --tail "$n" "$CONTAINER" 2>&1
}

# скрытый алиас совместимости: mode single|slots [N] == use 27b-*
cmd_mode() {
  local m="${1:-}"; [ -n "$m" ] || die "использование: hfctl mode single|slots [N]"
  [ -n "${2:-}" ] && SLOTS="$2"
  cmd_use "$m"
}

cmd_autostart() {
  local unit_dir="$HOME/.config/systemd/user" bin
  bin="$(command -v podman)"
  mkdir -p "$unit_dir"
  # юниты ссылаются на $STACK_DIR/hfctl — убедимся, что копия на месте
  if [ ! -f "$STACK_DIR/hfctl" ] && [ "$SELF" != "$STACK_DIR/hfctl" ]; then
    mkdir -p "$STACK_DIR"; cp "$SELF" "$STACK_DIR/hfctl"; chmod +x "$STACK_DIR/hfctl"
  fi
  cat > "$unit_dir/$UNIT_NAME.service" <<EOF
[Unit]
Description=hipfire serve (podman compose stack, hfctl)
After=podman-user-wait-network-online.service

[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=process          # не убивать cgroup контейнеров при остановке юнита
WorkingDirectory=$STACK_DIR
ExecStart=/usr/bin/env bash $STACK_DIR/hfctl _boot
ExecStop=$bin compose ${CF[*]} stop
TimeoutStartSec=900
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
EOF
  # вотчдог крашей: rootless podman не оставляет живого наблюдателя после
  # `compose up -d` (проверено kill-тестом), поэтому раз в минуту проверяем,
  # что контейнер жив, если только стек не остановлен ЯВНО (hfctl down / off
  # пишут marker).
  cat > "$unit_dir/$UNIT_NAME-watchdog.service" <<EOF
[Unit]
Description=hipfire watchdog (hfctl): поднимает стек после нештатного падения

[Service]
Type=oneshot
# ВАЖНО: без KillMode=process systemd при завершении oneshot-юнита убивает
# весь cgroup — вместе с только что поднятым контейнером (SIGTERM/143).
KillMode=process
ExecStart=/usr/bin/env bash $STACK_DIR/hfctl _watchdog
EOF
  cat > "$unit_dir/$UNIT_NAME-watchdog.timer" <<EOF
[Unit]
Description=hipfire watchdog timer (hfctl, 1 min)

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
RandomizedDelaySec=10

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT_NAME.service" "$UNIT_NAME-watchdog.timer"
  systemctl --user start "$UNIT_NAME-watchdog.timer"
  rm -f "$STOP_MARKER"
  sudo loginctl enable-linger "$USER"
  echo "автозапуск ВКЛ (unit + watchdog-таймер 1м, linger=yes)"
}

# общий lock: параллельные `compose up -d` (вотчдог + boot + ручной up) дерутся
# за netns — пускаем только один одновременно
hf_up_locked() {
  ( flock -n 9 || { echo "up уже выполняется — пропуск"; return 0; }
    compose up -d 2>&1 | tail -2
  ) 9>"$STACK_DIR/.hfctl.lock"
}

# внутренняя команда загрузочного юнита: GPU-ноды (/dev/dri/card0) при boot
# появляются позже юзера — стучимся до появления/успеха (до ~4 мин)
cmd_boot() {
  local i
  for i in $(seq 1 24); do
    # ядро ROCm — renderD*; у Halo может не быть card0 вообще (нумерация с 1)
    if ! compgen -G "/dev/dri/renderD*" >/dev/null || [ ! -e /dev/kfd ]; then sleep 10; continue; fi
    if hf_up_locked; then :; fi
    if [ "$(podman inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null)" = running ]; then
      return 0
    fi
    # не поднялся: возможно,devices востребовались иначе (перенумерация
    # /dev/dri между загрузками) — пересоздаём контейнер раз в 3 попытки
    [ $((i % 3)) -eq 0 ] && ( flock -n 9 || true; compose up -d --force-recreate 2>&1 | tail -1 ) 9>"$STACK_DIR/.hfctl.lock" || true
    sleep 10
  done
  echo "boot: контейнер так и не запущен за 4 мин" >&2
  return 1
}

# внутренняя команда вотчдога (не для ручного запуска)
cmd_watchdog() {
  [ -f "$STOP_MARKER" ] && return 0
  local st
  st=$(podman inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo missing)
  if [ "$st" != running ]; then
    echo "$(date -Is) watchdog: container state=$st -> up" >> "$STACK_DIR/.hfctl-watchdog.log" 2>/dev/null || true
    hf_up_locked || true
  fi
}

cmd_doctor() {  # диагностика без изменений (spec §3): gейты + что мешает
  local have; have=$(ram_pool_gib)
  echo "── система ──"
  . /etc/os-release && echo "ОС: $PRETTY_NAME"
  echo "память: пул ${have} GiB (MemTotal); доступно сейчас: $(awk '/MemAvailable/{printf "%d", $2/1048576}' /proc/meminfo) GiB"
  echo "GPU: /dev/kfd $([ -e /dev/kfd ] && echo есть || echo НЕТ), /dev/dri/renderD* $(compgen -G '/dev/dri/renderD*' >/dev/null && echo есть || echo НЕТ)"
  echo "── профили (RAM-гейт) ──"
  local p
  for p in $PROFILE_LIST; do
    local need; need=$(profile_field "$p" 4)
    if [ "$have" -ge "$need" ]; then
      echo "  $p: доступен (нужно ≥${need} GiB)"
    else
      echo "  $p: НЕДОСТУПЕН (нужно ≥${need} GiB, есть ${have})"
    fi
  done
  echo "── установка ──"
  if [ -f "$STACK_DIR/.env" ]; then
    echo "стек: $STACK_DIR (профиль $(cur_profile), модель $(cur_model))"
  else
    echo "стек: НЕ УСТАНОВЛЕН ($STACK_DIR/.env нет) — 'hfctl install'"
  fi
  echo "── окружение ──"
  command -v podman >/dev/null && echo "podman: $(podman --version)" || echo "podman: НЕТ (install поставит)"
  command -v podman-compose >/dev/null && echo "podman-compose: есть" || echo "podman-compose: НЕТ (install поставит)"
  id -nG | grep -qw render && echo "группа render: есть" || echo "группа render: НЕТ (install добавит, перелогин)"
  local lim="/etc/security/limits.d/99-hipfire-memlock.conf"
  [ -f "$lim" ] && echo "memlock limits: есть ($lim)" || echo "memlock limits: НЕТ (install напишет, ребут)"
  # gpu-lock: эксклюзивен — чужой держатель = отказ запуска
  local lockdir="/run/lock/hipfire" f
  if [ -d "$lockdir" ]; then
    for f in "$lockdir"/gpu-pci-*.lock; do
      [ -e "$f" ] || continue
      if fuser -v "$f" 2>&1 | grep -q hipfire; then
        warn "gpu-lock занят: $f ($(fuser -v "$f" 2>&1 | tail -1)) — второй serve не стартует"
      else
        echo "gpu-lock: свободен ($f)"
      fi
    done
  fi
  echo "── health ──"
  curl -fsS -m 5 "http://127.0.0.1:$PORT/health" 2>/dev/null | head -c 200 || echo "(сервер не отвечает)"
  echo
}

cmd_models() {  # что скачано и что требует каждый профиль (spec §3)
  echo "── на диске (по сетам профилей, в $MODELS_BASE) ──"
  local s total
  for s in 27b flash; do
    if [ -d "$MODELS_BASE/$s" ]; then
      total=$(du -sh "$MODELS_BASE/$s" 2>/dev/null | cut -f1)
      echo "  $s: $total"
    fi
  done
  [ -d "$MODELS_BASE" ] || echo "(каталога нет — ничего не скачано)"
  echo "── профили: доступность ──"
  local p have; have=$(ram_pool_gib)
  for p in $PROFILE_LIST; do
    local need avail
    need=$(profile_field "$p" 4)
    if [ "$have" -ge "$need" ]; then avail="доступен"; else avail="НЕДОСТУПЕН (RAM: есть ${have} GiB, нужно ≥${need})"; fi
    echo "  $p → сет models/$(model_set "$p") [$avail]"
  done
  echo "изоляция: монтируется только сет активного профиля — запрос с моделью"
  echo "чужого сета получит 404 (молчаливый swap невозможен)"
}

cmd_pull() {  # hfctl pull <profile> — скачать сет модели БЕЗ переключения
  local p="${1:-}"
  [ -n "$p" ] || die "использование: hfctl pull <profile> (${PROFILE_LIST// /|})"
  p=$(resolve_profile "$p") || die "неизвестный профиль '$p' (доступны: $PROFILE_LIST)"
  # скачивание ≠ запуск: RAM-гейт НЕ применяем (бэкап-сет на слабой машине легален)
  [ -f "$STACK_DIR/.env" ] || die "стек не установлен — сначала 'hfctl install'"
  [ -d "$MODELS_BASE" ] || mkdir -p "$MODELS_BASE"
  migrate_models
  local target="$MODELS_BASE/$(model_set "$p")"
  mkdir -p "$target"
  log "тяну сет '$(model_set "$p")' профиля $p в $target (без переключения профиля)"
  MODELS_DIR="$target" pull_profile_models "$p"
  echo "готово: $target"
  echo "(активация — 'hfctl use $p'; RAM-гейт оценивается при use)"
}

cmd_uninstall() {
  local purge_models=0 purge_image=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge-models) purge_models=1; shift ;;
      --purge-image)  purge_image=1; shift ;;
      *) die "неизвестный флаг uninstall: $1" ;;
    esac
  done
  echo "uninstall снимет: контейнеры, сеть проекта, volumes (config/kernels),"
  echo "юниты+таймер автозапуска, limits.d, каталог стека $STACK_DIR (включая hfctl)."
  echo "Модели $MODELS_DIR: $([ "$purge_models" = 1 ] && echo 'УДАЛЯЮТСЯ (--purge-models)' || echo 'СОХРАНЯЮТСЯ (переезжают в стеке)')"
  echo "Образ $IMAGE: $([ "$purge_image" = 1 ] && echo 'УДАЛЯЕТСЯ (--purge-image)' || echo 'остаётся (--purge-image — удалить)')"
  echo "Не трогаем: podman, группа render, чужие каталоги."
  ask "Продолжить? [y/N] " || { echo "отменено"; exit 0; }
  cmd_off || true
  ( cd "$STACK_DIR" 2>/dev/null && compose down 2>&1 | tail -2 ) || true
  podman volume rm hipfire_hipfire-config hipfire_hipfire-kernels 2>/dev/null || true
  # модели живут внутри стека: при сохранении — временно переезжают, потом назад
  keep=""
  if [ "$purge_models" != 1 ] && [ -d "$MODELS_DIR" ]; then
    keep="$(dirname "$STACK_DIR")/.hfctl-models-$$"
    mv "$MODELS_DIR" "$keep"
  fi
  rm -rf "$STACK_DIR"
  if [ -n "$keep" ]; then mkdir -p "$STACK_DIR"; mv "$keep" "$MODELS_DIR"; fi
  if [ -f /etc/security/limits.d/99-hipfire-memlock.conf ]; then
    sudo rm -f /etc/security/limits.d/99-hipfire-memlock.conf
  fi
  if [ "$purge_models" = 1 ]; then echo "модели удалены"; fi
  if [ "$purge_image" = 1 ];  then podman rmi "$IMAGE" 2>/dev/null || true; echo "образ удалён"; fi
  echo "uninstall DONE"
}

usage() {
  sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)      cmd_install "$@" ;;
  use)          cmd_use "$@" ;;
  on)           cmd_on ;;
  off)          cmd_off ;;
  status)       cmd_status "$@" ;;
  logs)         cmd_logs "$@" ;;
  doctor)       cmd_doctor ;;
  models)       cmd_models ;;
  pull)         cmd_pull "$@" ;;
  up)           cmd_up ;;          # скрытый алиас
  down)         cmd_down ;;        # скрытый алиас
  mode)         cmd_mode "$@" ;;   # скрытый алиас
  autostart)    cmd_on ;;          # скрытый алиас
  noautostart)  cmd_off ;;         # скрытый алиас
  _watchdog)    cmd_watchdog ;;
  _boot)        cmd_boot ;;
  uninstall)    cmd_uninstall "$@" ;;
  "")           usage ;;
  *)            echo "неизвестная команда '$cmd'. Команды: install | use <profile> | status [--json] | logs | on | off | doctor | models | pull <profile> | uninstall" \
                  " (алиасы: up|down|mode|autostart|noautostart). Профили: $PROFILE_LIST" >&2; exit 1 ;;
esac
