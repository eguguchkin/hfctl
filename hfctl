bench_slots() {  # фактическое число слотов (health → fallback на $SLOTS)
  local s
  s=$(curl -fsS -m 5 "http://127.0.0.1:$PORT/health" 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
print(d.get("capabilities",{}).get("multi_slot_slots") or "")' 2>/dev/null || true)
