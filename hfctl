#!/usr/bin/env bash
# === USAGE-BEGIN ===
# hfctl — деплой и управление hipfire-сервером (Strix Halo / gfx11xx) на
# Ubuntu/Debian. Раскладывается деревом: диспетчер hfctl + lib/*.sh + tpl/
# (шаблоны compose/.env/юнитов/python/фикстуры); запускается ОТ СВОЕГО ИМЕНИ
# (не root; sudo применяется точечно):
#   git clone <repo> && cd hfctl && ./install.sh   # бинарь в стек + симлинк в bin
#
# Команды:
#   install [--profile P] [--port N] [--bind A] [--models-dir D] [--no-autostart]
#   use <profile>                — переключить профиль (+recreate, заменяет
#                                  конфиг автозапуска; недостающие модели
#                                  докачиваются с вопросом)
#   status [--json] | logs [-f] [-n N]
#   watch [--interval N]         — живой наблюдатель: очередь/обслужено/tok-s
#                                  последнего done/кэш (cached tokens) и
#                                  температура GPU; в простое молчит
#   on | off                     — автозапуск вкл / выкл (off = стоп + снятие
#                                  с автозапуска; файлы/модели/образ целы)
#   uninstall [--purge-models] [--purge-image]
#   bench [full] [--runs N] [--out DIR] [--json] [--compare [FILE]] [--fresh]
# === USAGE-END ===
set -euo pipefail

# ── локальные типы ───────────────────────────────────────────────────────────
# @typedef profile_id: '27b-single' | '27b-slots' | 'flash-multi'
#
# @typedef container_name: /^hipfire_\w+_\d+$/
#
# @typedef systemd_unit: /^hipfire-[\w-]+$/

# ── конфигурация (env переопределяет) ───────────────────────────────────────
# @type /^[\w./-]+:[\w.-]+$/ IMAGE="${HFCTL_IMAGE:-ghcr.io/warpfront/hipfire:0.4.5}" # образ ghcr с тегом; переопределение — env HFCTL_IMAGE
IMAGE="${HFCTL_IMAGE:-ghcr.io/warpfront/hipfire:0.4.5}"
STACK_DIR="${HFCTL_DIR:-$HOME/hipfire}"          # всё инсталляция здесь (compose, .env, бинарь)
MODELS_BASE="${HFCTL_MODELS:-$STACK_DIR/models}" # база моделей; внутри — каталог-сет на профиль
MODELS_DIR="$MODELS_BASE/27b"                    # маунт; пересчитывается set_models_dir()
# per-профиль state-каталоги (этап 7): config (home движка: конфиг, disk-тир
# кэша, pid) и kernel (кэш прекомпилированных ядер). Bind вместо named
# volumes — состояние явное, per-профиль по конструкции, backup = tar.
STATE_BASE="${HFCTL_STATE:-$STACK_DIR/profiles}"
# @type /^\d+$/              PORT="${HFCTL_PORT:-11435}"                             # TCP-порт; переопределение — env HFCTL_PORT
PORT="${HFCTL_PORT:-11435}"
# @type /^[\d.]+$/           BIND="${HFCTL_BIND:-0.0.0.0}"                           # адрес bind; переопределение — env HFCTL_BIND
BIND="${HFCTL_BIND:-0.0.0.0}"                    # 0.0.0.0 = LAN без ключа; 127.0.0.1 = локально
# ВАЖНО: в контейнер models монтируется на /home/hipfire/.hipfire/models —
# HIPFIRE_DFLASH_DRAFT указывается КОНТЕЙНЕРНЫМ путём, не хостовым.
DRAFT_FILE="/home/hipfire/.hipfire/models/qwen38-27b-dflash-mq4.hfq"
# @type /^(2|3)$/            SLOTS="${HFCTL_SLOTS:-2}"                               # слотов в 27b-slots; переопределение — env HFCTL_SLOTS
SLOTS="${HFCTL_SLOTS:-2}"                        # слотов в 27b-slots (4×262144 не влезает в OOM-guard)
# @type container_name       CONTAINER=hipfire_hipfire_1                             # podman-compose имя <project>_<service>_<n>
CONTAINER=hipfire_hipfire_1
# @type systemd_unit         UNIT_NAME=hipfire-compose                               # базовое имя user-юнитов (+…-watchdog.*)
UNIT_NAME=hipfire-compose
STOP_MARKER="$STACK_DIR/.hfctl-stopped"   # явная остановка: вотчдог не встаёт
SELF="$(readlink -f "$0")"
MAX_SEQ=262144
MEMLOCK=1318060032
LIB_DIR="$(cd "$(dirname "$SELF")" && pwd)/lib"  # дерево = рядом с диспетчером
TPL_DIR="$(cd "$(dirname "$SELF")" && pwd)/tpl"

# ── общие хелперы ────────────────────────────────────────────────────────────
# Назначение: единый заголовок этапа — жирная голубая строка «== <текст>» в
#   stdout.
#
# Побочные эффекты: запись в stdout (ANSI-раскраска безусловная, в том числе
#   при не-TTY выводе) + leading-пустая строка перед заголовком. Файлы и
#   состояние не меняет.
#
# Ограничения/допущения: не terminating (в отличие от die()); возвращает 0
#   при успехе печати, сбой печати ловит set -e; раскраска не глушится при
#   перенаправлении stdout. Требует глобалов диспетчера и lib-модулей.
#
# @param 1..N: string[] # текст сообщения (аргументы соединяются через "$*")
# @returns integer      # 0 при успехе печати; сбой печати прерывает set -e
# @stdout string        # строка «== <текст>» с ANSI-обрамлением
log()  { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }

# Назначение: единый формат предупреждения — печать текста в stderr с жёлтым
#   префиксом «WARN:».
#
# Побочные эффекты: запись в stderr (ANSI-раскраска безусловная, в том числе
#   при не-TTY выводе). Файлы и состояние не меняет; процесс не завершает.
#
# Ограничения/допущения: не terminating (предупреждение не отменяет команду;
#   возвращает 0 при успехе печати); раскраска не глушится при перенаправлении
#   stderr. Требует глобалов диспетчера и lib-модулей.
#
# @param 1..N: string[] # текст сообщения (аргументы соединяются через "$*")
# @returns integer      # всегда 0 — только печать; сбой печати ловит set -e
# @stderr string        # строка «WARN: <текст>»
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }

# Назначение: единый формат фатальной ошибки — печать текста в stderr с
#   красным префиксом «FATAL:» и завершение процесса с кодом 1.
#
# Побочные эффекты: запись в stderr (ANSI-раскраска безусловная) + exit 1 —
#   весь процесс диспетчера (вместе с source'нутыми lib-модулями)
#   прекращается; дописания в файлы после вызова не происходит.
#
# Ограничения/допущения: никогда не возвращает управление — exit внутри
#   функции; вызывается из всех lib-модулей, код отказа фиксирован —
#   всегда 1, других кодов die не выдаёт.
#
# @param 1..N: string[] # текст сообщения (аргументы соединяются через "$*")
# @returns integer      # не возвращается — exit 1 внутри функции (типа «never»
#   в системе нет; код отказа фиксирован: 1)
# @stderr string        # строка «FATAL: <текст>»
die()  { printf '\033[1;31mFATAL:\033[0m %s\n' "$*" >&2; exit 1; }

# ── неинтерактив: вопросы только при TTY (--yes — авто-да) ──────────────────
# @type '' | '1' ASSUME_YES="${HFCTL_YES:-}"                                         # '1' = авто-да (--yes / HFCTL_YES=1)
ASSUME_YES="${HFCTL_YES:-}"

# Назначение: интерактивный вопрос «да/нет» — 0 при ответе y, безопасный
#   автоотказ (rc 1) в неинтерактивном контексте без --yes.
#
# Побочные эффекты: чтение stdin (read -r с prompt'ом); печать пояснения про
#   авто-нет в stdout; файлы и глобалы не меняет.
#
# Ограничения/допущения: требует глобал ASSUME_YES этого файла ('1' —
#   авто-да без вопроса); prompt печатается read -p на TTY; подтверждение —
#   ровно строчная 'y' (пустой ввод, 'Y', 'yes' — отказ); не terminating.
#
# @param 1: string # текст вопроса (prompt)
# @returns integer # 0 — да (y или ASSUME_YES=1); 1 — нет/автоотказ
ask() {  # ask <question> — 0 при да; при не-TTY и без --yes — отказ (безопасно)
  [ "$ASSUME_YES" = 1 ] && return 0
  if [ ! -t 0 ]; then echo "(неинтерактивный режим: авто-нет; повтори с --yes)"; return 1; fi
  local a; read -r -p "$1" a; [ "$a" = y ]
}

# Назначение: предикат «строка — целое без знака» — ноль или больше цифр; rc
#   0/1 вместо печати (используется в if/арифметических проверках watch).
#
# Побочные эффекты: ничего не печат и не меняет — только возвращаемый код.
#
# Ограничения/допущения: пустая строка — НЕ целое (rc 1); ведущие нули
#   допускаются; знак, пробелы и любые не-цифры — rc 1. Требует ровно один
#   аргумент: при пустом $1 set -u завершил бы процесс до разбора.
#
# @param 1: string    # проверяемое значение (живые вызовы: --interval,
#   числа из /stats и /metrics)
# @returns integer    # 0 — только цифры (в т.ч. пустая строка НЕ проходит);
#   1 — иначе
isint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

# ── lib-модули (порядок: от данных к командам; зависимости функций — lazy) ──
# Назначение: подключение дерева lib/ — порядок source фиксирован и значим.
#
# Побочные эффекты: source выполняет код модулей в процессе диспетчера
#   (определения функций + инициализация глобалов модулей, напр. CF из
#   stack.sh).
#
# Ограничения/допущения: порядок ниже неизменен: profiles.sh — раньше всех
#   (нужны только env-глобалы SLOTS/MAX_SEQ, задаёт PROFILE_DEFAULT/
#   PROFILE_LIST, от которых зависит stack.sh); stack.sh — до всех, кто зовёт
#   compose/env_val (нужны log/warn/die этого файла); далее команды — по
#   зависимостям функций (bench использует всё выше). Модули не объявляют
#   заглушек на глобалы диспетчера: SC2034 выше — ожидаемые.
source "$LIB_DIR/profiles.sh"     # table+resolve+gates (нужны только env-константы)
source "$LIB_DIR/stack.sh"        # CF/compose/env_val/cur_profile/preflight (нужны log/warn/die)
source "$LIB_DIR/state.sh"        # каталоги моделей по сетам
source "$LIB_DIR/stack_files.sh"  # render_tpl, sync_tree, write_stack_files, write_env
source "$LIB_DIR/engine.sh"       # cfgset/apply_profile
source "$LIB_DIR/health.sh"       # wait_health/smoke/check_route
source "$LIB_DIR/models.sh"       # pull*
source "$LIB_DIR/commands.sh"     # install/use/status/…/uninstall
source "$LIB_DIR/autostart.sh"    # on/off/up/down/_boot/_watchdog
source "$LIB_DIR/bench.sh"        # bench (использует всё выше)

# Назначение: справка по командам диспетчера — печать шапки этого файла
#   (текст между маркерами USAGE-BEGIN/USAGE-END) со снятым префиксом «# ».
#
# Побочные эффекты: только печать в stdout; читает сам файл диспетчера
#   ($0); ничего не меняет.
#
# Ограничения/допущения: НЕ terminating — печатает и возвращает 0 (выход на
#   совести вызывающего: роутер ниже завершает процесс сам). Диапазон —
#   маркеры USAGE-BEGIN/USAGE-END в шапке этого файла, НЕ номера строк
#   (грабля старых версий): правка текста помощи не требует синхронной
#   правки sed-аргумента; сами маркеры (и их литералы где бы то ни было —
#   sed находит диапазон по шапке) в вывод не входят.
#
# @returns integer # всегда 0 — только печать; сбой чтения/печати ловит set -e
# @stdout string   # текст справки (текст между маркерами шапки)
usage() {
  sed -n '/^# === USAGE-BEGIN ===$/,/^# === USAGE-END ===$/p' "$0" | sed '1d;$d;s/^# \{0,1\}//'
}

# ── роутер команд (верхнеуровневый скоуп, не функция) ───────────────────────
# Назначение: разбор $1 в команду и диспетчеризация на cmd_* из lib-модулей.
#
# Побочные эффекты: все побочные эффекты выбранной команды (она и завершает
#   процесс своим rc; ветка '' печатает usage, ветка «*» — отказ с выводом в
#   stderr и rc 1).
#
# Ограничения/допущения: работает в верхнеуровневом скоупе диспетчера под
#   set -euo pipefail: `shift || true` легализует запуск без аргументов;
#   скрытые алиасы: up|down|mode → cmd_up/cmd_down/cmd_mode (autostart.sh),
#   autostart|noautostart → cmd_on|cmd_off, _boot|_watchdog — внутренние
#   команды systemd-юнитов (autostart.sh); PROFILE_LIST в отказной ветке —
#   из profiles.sh.
#
# @param 1: string      # имя команды (см. usage; '' → usage)
# @param 2..N: string[] # аргументы команды — передаются как есть ("$@")
cmd="${1:-}"; shift || true
case "$cmd" in
  install)      cmd_install "$@" ;;
  use)          cmd_use "$@" ;;
  on)           cmd_on ;;
  off)          cmd_off ;;
  status)       cmd_status "$@" ;;
  logs)         cmd_logs "$@" ;;
  watch)        cmd_watch "$@" ;;
  doctor)       cmd_doctor ;;
  models)       cmd_models ;;
  pull)         cmd_pull "$@" ;;
  bench)        cmd_bench "$@" ;;
  up)           cmd_up ;;          # скрытый алиас
  down)         cmd_down ;;        # скрытый алиас
  mode)         cmd_mode "$@" ;;   # скрытый алиас
  autostart)    cmd_on ;;          # скрытый алиас
  noautostart)  cmd_off ;;         # скрытый алиас
  _watchdog)    cmd_watchdog ;;
  _boot)        cmd_boot ;;
  uninstall)    cmd_uninstall "$@" ;;
  "")           usage ;;
  *)            echo "неизвестная команда '$cmd'. Команды: install | use <profile> | status [--json] | logs | watch | on | off | doctor | models | pull <profile> | bench [full] | uninstall" \
                  " (алиасы: up|down|mode|autostart|noautostart). Профили: $PROFILE_LIST" >&2; exit 1 ;;
esac
