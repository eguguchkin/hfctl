}

bench_longgen() {  # 4096 tok decode + стабильность (первая/последняя tok/s= из логов, best-effort)
  local i out w pt toks tk ok=0 first last vals start
  bench_payload "$BENCH_TMP/long.json" "$BENCH_TMP/c_long.txt" 4096
  start=$(date +%s)
  for i in $(seq 1 "$RUNS"); do
    if out=$(bench_req "$BENCH_TMP/long.json" "$BENCH_TMP/long_resp" 600); then
      read -r w pt toks <<<"$out"
      tk=$(awk -v t="$toks" -v s="$w" 'BEGIN{ if (s+0>0) printf "%.2f", t/s; else print "" }')
      printf 'long-gen\t%s\t%s\t%s\t-\t-\n' "$w" "$toks" "$tk" >> "$BENCH_TMP/runs.tsv"
      ok=$((ok+1))
    else
      warn "long-gen: прогон $i не удался — пропущен"
    fi
  done
  vals=$(podman logs --since "$(( $(date +%s) - start + 2 ))s" "$CONTAINER" 2>&1 \
         | grep -oE "tok/s=[0-9.]+" | cut -d= -f2) || true
  first=$(printf '%s\n' "$vals" | sed -n '1p')
  last=$(printf '%s\n' "$vals" | tail -1)
  if [ -n "$first" ] && [ -n "$last" ]; then
    export B_NOTE_long_gen="движок: $first → $last tok/s (первая → последняя)"
  else
    export B_NOTE_long_gen="движковый tok/s в логах нет (best-effort)"
  fi
  [ "$ok" -gt 0 ] || warn "long-gen: все прогоны не удались — сценарий пропущен"
  return 0
}

bench_parallel() {  # bench_parallel <N> — N одновременных curl; aggregate + интерпретация по роуту
  local n="$1" i t0 t1 tw sum tk fails=0 pw=""
  for i in $(seq 1 "$n"); do
    if [ $((i % 2)) = 1 ]; then
      bench_payload "$BENCH_TMP/par$i.json" "$BENCH_TMP/c_prose.txt" 300
    else
      bench_payload "$BENCH_TMP/par$i.json" "$BENCH_TMP/c_code.txt" 300
    fi
  done
  rm -f "$BENCH_TMP"/par_resp_* "$BENCH_TMP"/par_wall_*
  t0=$(date +%s.%N)
  for i in $(seq 1 "$n"); do
    (
      w0=$(date +%s.%N)
      curl -fsS -m 300 "http://127.0.0.1:$PORT/v1/chat/completions" \
        -H 'Content-Type: application/json' --data-binary @"$BENCH_TMP/par$i.json" \
        > "$BENCH_TMP/par_resp_$i" 2>/dev/null || true
      w1=$(date +%s.%N)
      awk -v a="$w0" -v b="$w1" 'BEGIN{printf "%.1f\n", b-a}' > "$BENCH_TMP/par_wall_$i"
    ) &
  done
  wait
  t1=$(date +%s.%N)
  tw=$(awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.3f", b-a}')
  sum=0
  for i in $(seq 1 "$n"); do
    tk=""
    if [ -s "$BENCH_TMP/par_resp_$i" ]; then
      tk=$(python3 -c '
import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(3)
u = d.get("usage") or {}
ct = u.get("completion_tokens")
print("" if ct is None else ct)' "$BENCH_TMP/par_resp_$i" 2>/dev/null || true)
    fi
    case "$tk" in ''|*[!0-9]*) fails=$((fails+1)) ;; *) sum=$((sum+tk)) ;; esac
  done
  [ "$fails" = 0 ] || warn "parallel-$n: $fails из $n запросов не удались (curl/usage)"
  if [ "$sum" -eq 0 ]; then
    warn "parallel-$n: ни одного ответа с usage — сценарий пропущен"
    return 0
  fi
  printf 'parallel-%s\t%s\t%s\t%s\t-\t-\n' "$n" "$tw" "$sum" \
    "$(awk -v s="$sum" -v s2="$tw" 'BEGIN{printf "%.2f", s/s2}')" >> "$BENCH_TMP/runs.tsv"
  for i in $(seq 1 "$n"); do
    [ -s "$BENCH_TMP/par_wall_$i" ] && pw="$pw$(cat "$BENCH_TMP/par_wall_$i")с " || true
  done
  export B_NOTE_parallel_$n="per-request wall: ${pw:-нет данных}"
  case "$ROUTE" in
    lanes)
      if [ -n "${MED_SOLO_CODE:-}" ]; then
        awk -v a="$(bench_med "parallel-$n" 4)" -v s="$MED_SOLO_CODE" -v n="$n" \
          'BEGIN{ if (s+0>0) printf "parallel-%s: масштабирование: aggregate/solo = %.0f%%\n", n, a/s*100 }'
      else
        echo "parallel-$n: aggregate $(bench_med "parallel-$n" 4) tok/s (соло-рейт неизвестен — процент не посчитать)"
      fi ;;
    multi-slot)
      echo "parallel-$n: очередь слотов (слотов=$(bench_slots)): N>$(bench_slots) ждут свободный слот" ;;
    *)
      echo "parallel-$n: FIFO: aggregate ≈ solo — норма для serial-роута" ;;
  esac
  return 0
}

bench_hol() {  # длинный в фоне, через 2 c короткий; мера wall короткого vs сольный референс
  local i out ok=0 ref_w="" w0 lpid
  bench_payload "$BENCH_TMP/hol_long.json" "$BENCH_TMP/c_long.txt" 800
  bench_payload "$BENCH_TMP/hol_short.json" "$BENCH_TMP/c_ttft.txt" 8
  # сольный референс короткого (1 прогон, вне таблицы)
  if out=$(bench_req "$BENCH_TMP/hol_short.json" "$BENCH_TMP/hol_ref_resp" 120); then
    read -r ref_w _ <<<"$out"
  fi
  BENCH_HOL_REF="$ref_w"
  for i in $(seq 1 "$RUNS"); do
    curl -fsS -m 600 "http://127.0.0.1:$PORT/v1/chat/completions" \
      -H 'Content-Type: application/json' --data-binary @"$BENCH_TMP/hol_long.json" \
      > "$BENCH_TMP/hol_long_resp" 2>/dev/null &
    lpid=$!
    sleep 2
    if out=$(bench_req "$BENCH_TMP/hol_short.json" "$BENCH_TMP/hol_short_resp" 120); then
      read -r w0 _ <<<"$out"
      printf 'hol\t%s\t-\t-\t-\t-\n' "$w0" >> "$BENCH_TMP/runs.tsv"
      ok=$((ok+1))
    else
      warn "HOL: короткий запрос не удался — прогон пропущен"
    fi
    wait "$lpid" 2>/dev/null || true   # длинный доигрывает до следующего прогона
  done
  [ "$ok" -gt 0 ] || warn "HOL: все прогоны не удались — сценарий пропущен"
  return 0
}

bench_write_py() {  # python-помощники: ttft (SSE) + таблица/артефакт/compare
  cat > "$BENCH_TMP/ttft.py" <<'PYEOF'
import json, sys, time, urllib.request

url, pfile = sys.argv[1], sys.argv[2]
payload = json.load(open(pfile, encoding="utf-8"))
req = urllib.request.Request(
    url, data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
    headers={"Content-Type": "application/json"})
t0 = time.perf_counter()
ttft = None
try:
    resp = urllib.request.urlopen(req, timeout=120)
except Exception as e:
    print("ERR", e)
    sys.exit(0)
try:
    for raw in resp:
        line = raw.decode("utf-8", "replace").strip()
        if not line.startswith("data:"):
            continue
        d = line[5:].strip()
        if d == "[DONE]":
            break
        try:
            obj = json.loads(d)
        except Exception:
            continue
        hit = False
        for ch in obj.get("choices") or []:
            if ((ch.get("delta") or {}).get("content") or "").strip():
                ttft = (time.perf_counter() - t0) * 1000.0
                hit = True
                break
        if hit:
            break
finally:
    try:
        resp.close()
    except Exception:
        pass
print("null" if ttft is None else "%.0f" % ttft)
PYEOF

  cat > "$BENCH_TMP/bench_py.py" <<'PYEOF'
import json, os, statistics, sys

def _f(x):
    x = (x or "").strip()
    return None if x in ("", "-") else float(x)

def _n(x):
    v = _f(x)
    if v is None:
        return None
    return int(v) if float(v).is_integer() else v

def load_runs():
    runs = {}
    for line in open(os.environ["B_RUNS"], encoding="utf-8"):
        p = line.rstrip("\n").split("\t")
        if len(p) < 6 or not p[0]:
            continue
        runs.setdefault(p[0], []).append({
            "wall": _f(p[1]), "tokens": _n(p[2]), "tok_s": _f(p[3]),
            "tau": _f(p[4]), "ttft_ms": _f(p[5])})
    return runs

ORDER = ["solo-code", "solo-prose", "ttft", "prefill-100k", "long-gen",
         "parallel-2", "parallel-4", "hol", "ar-baseline"]
UNITS = {"ttft": "мс", "hol": "с", "prefill-100k": "tok/s",
         "parallel-2": "tok/s agg", "parallel-4": "tok/s agg"}
# главная метрика сценария (для сводки и сравнения): tok_s у скоростных,
# ttft у отзывчивости, wall у HOL
MAIN = {"ttft": ("ttft_ms", "мс"), "hol": ("wall", "с")}

def main_vals(sc, rs):
    key, unit = MAIN.get(sc, ("tok_s", UNITS.get(sc, "tok/s")))
    return unit, [e.get(key) for e in rs if e.get(key) is not None]

def summary_of(runs):
    sm = {}
    for sc in ORDER:
        rs = runs.get(sc) or []
        if not rs:
            continue
        unit, vals = main_vals(sc, rs)
        if not vals:
            continue
        sm[sc] = {"median": round(statistics.median(vals), 3),
                  "min": round(min(vals), 3), "max": round(max(vals), 3),
                  "unit": unit}
    if os.environ.get("B_FULL") == "1":
        sm["ar-baseline"] = {"unit": "—", "median": None, "min": None, "max": None,
                             "note": "пропущен (сравнение спекуляция/нет — через use разных профилей)"}
    return sm

def fmt_med(vals, unit, sc, nd=2):
    med = statistics.median(vals)
    s = "%g %s" % (round(med, nd), unit)
    if len(vals) > 1:
        s += " (%g–%g)" % (round(min(vals), nd), round(max(vals), nd))
        if med:
            sp = (max(vals) - min(vals)) / med * 100.0
            if sp > 5:
                print("WARN: %s: разброс прогонов %.0f%% > 5%% — система занята?" % (sc, sp),
                      file=sys.stderr)
    return s

def do_report(runs):
    print()
    print("%-18s %-30s %-9s %-18s %s" % ("сценарий", "decode", "τ", "TTFT", "примечание"))
    for sc in ORDER:
        rs = runs.get(sc) or []
        if not rs:
            continue
        dec = ttft = tau = "—"
        if sc == "ttft":
            vals = [e["ttft_ms"] for e in rs if e.get("ttft_ms") is not None]
            if vals:
                ttft = fmt_med(vals, "мс", sc)
        elif sc == "hol":
            vals = [e["wall"] for e in rs if e.get("wall") is not None]
            if vals:
                ttft = fmt_med(vals, "с", sc) + " (короткий)"
        elif sc != "ar-baseline":
            vals = [e["tok_s"] for e in rs if e.get("tok_s") is not None]
            if vals:
                dec = fmt_med(vals, UNITS.get(sc, "tok/s"), sc)
        taus = [e["tau"] for e in rs if e.get("tau") is not None]
        if taus:
            tau = "%.2f" % statistics.median(taus)
        print("%-18s %-30s %-9s %-18s %s" % (
            "%s (×%d)" % (sc, len(rs)), dec, tau, ttft,
            os.environ.get("B_NOTE_" + sc.replace("-", "_"), "")))
    print()

def do_artifact(runs):
    print(json.dumps({
        "timestamp": os.environ["B_TS"],
        "profile": os.environ["B_PROFILE"],
        "model": os.environ["B_MODEL"],
        "route": os.environ["B_ROUTE"],
        "image": os.environ["B_IMAGE"],
        "fixture_md5": os.environ["B_MD5"],
        "hfctl_version_placeholder": "",
        "runs": runs,
        "summary": summary_of(runs),
    }, ensure_ascii=False, indent=1))

def do_compare(basefile):
    base = json.load(open(basefile, encoding="utf-8"))
    cur = json.loads(os.environ["B_ARTIFACT"])
    bsm, csm = base.get("summary") or {}, cur.get("summary") or {}
    print("сравнение с прошлым прогоном (%s):" % os.path.basename(basefile))
    n = 0
    for sc in ORDER:
        c, b = csm.get(sc) or {}, bsm.get(sc) or {}
        cm, bm = c.get("median"), b.get("median")
        if cm is None or bm is None or not bm:
            continue
        d = (cm - bm) / bm * 100.0
        unit = c.get("unit") or b.get("unit") or ""
        verdict = ""
        if abs(d) >= 1.0:
            good = (d > 0) == ("tok/s" in unit)
            verdict = " — " + ("лучше" if good else "хуже")
        print("  %s: %+.1f%% (%g → %g %s)%s" % (sc, d, bm, cm, unit, verdict))
        n += 1
    if not n:
        print("  общих сценариев с цифрами нет")

cmd = sys.argv[1] if len(sys.argv) > 1 else ""
runs = load_runs()
if cmd == "report":
    do_report(runs)
elif cmd == "artifact":
    do_artifact(runs)
elif cmd == "compare":
    do_compare(sys.argv[2])
PYEOF
}

cmd_bench() {
  local mode="quick" runs=3 out_dir="" json_out=0 compare="" fresh=0
  while [ $# -gt 0 ]; do
    case "$1" in
      full|quick) mode="$1"; shift ;;
      --runs)
        case "${2:-}" in ''|*[!0-9]*) die "--runs: целое 1–20 (получено '${2:-}')" ;; esac
        [ "$2" -ge 1 ] && [ "$2" -le 20 ] || die "--runs: целое 1–20 (получено '$2')"
        runs="$2"; shift 2 ;;
      --out) [ -n "${2:-}" ] || die "--out: укажи каталог"; out_dir="$2"; shift 2 ;;
      --json) json_out=1; shift ;;
      --fresh) fresh=1; shift ;;
      --compare)
        if [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; then compare="$2"; shift 2
        else compare="auto"; shift; fi ;;
      --help|-h) bench_help; return 0 ;;
      *) die "неизвестный флаг bench: $1 (см. hfctl bench --help)" ;;
    esac
  done

  [ -f "$STACK_DIR/.env" ] || die "стек не установлен — сначала 'hfctl install'"
  local v
  v=$(env_val HIPFIRE_PORT); [ -n "$v" ] && PORT="$v"
  v=$(env_val HIPFIRE_BIND); [ -n "$v" ] && BIND="$v"

  # --json: человеческий вывод уходит в stderr, артефакт печатается в конце
  # в ИСХОДНЫЙ stdout (fd 4) — можно piping'нуть в jq.
  [ "$json_out" = 1 ] && exec 4>&1 1>&2

  BENCH_TMP="$(mktemp -d "${TMPDIR:-/tmp}/hfctl-bench.XXXXXX")"
  trap 'rm -rf "$BENCH_TMP"' EXIT
  : > "$BENCH_TMP/runs.tsv"
  OUT="${out_dir:-$STACK_DIR/bench-runs}"
  mkdir -p "$OUT"
  RUNS="$runs"

  local prof model md5_real body img ts_iso fname artifact base=""
  prof=$(cur_profile); model=$(cur_model)
  printf '%s' "$BENCH_FIXTURE" > "$BENCH_TMP/c_code.txt"
  md5_real=$(md5sum "$BENCH_TMP/c_code.txt" | cut -d' ' -f1)
  [ "$md5_real" = "$BENCH_FIXTURE_MD5" ] || \
    warn "md5 встроенной фикстуры $md5_real ≠ эталону $BENCH_FIXTURE_MD5 — сравнимость замеров под вопросом"
  printf '%s\n' "Напиши развёрнутое эссе о истории письменности" > "$BENCH_TMP/c_prose.txt"
  printf '%s\n' "Скажи ровно: ок" > "$BENCH_TMP/c_ttft.txt"
  printf '%s\n' "Напиши длинный рассказ о мореплавателе" > "$BENCH_TMP/c_long.txt"
  printf '%s\n' "Ответь одним предложением: прогрев бенча" > "$BENCH_TMP/c_warm.txt"
  bench_write_py

  if ! body=$(curl -fsS -m 5 "http://127.0.0.1:$PORT/health" 2>/dev/null); then
    die "сервер не отвечает (http://127.0.0.1:$PORT) — подними: hfctl up"
  fi
  if ! printf '%s' "$body" | python3 -c 'import json,sys
d=json.load(sys.stdin)
sys.exit(0 if d.get("status")=="ok" and d.get("model") and not d.get("loading_model") else 1)' 2>/dev/null; then
    log "модель ещё не готова — жду (как после 'hfctl up')"
    wait_health 900 || die "сервер так и не готов — смотри 'hfctl logs'"
  fi

  if [ "$fresh" = 1 ]; then
    log "--fresh: пересоздаю контейнер (recreate) — движок перечитает конфиг"
    compose up -d --force-recreate 2>&1 | tail -2
    wait_health 900 || die "сервер не поднялся после recreate — смотри 'hfctl logs'"
  fi

  local route rdesc
  route=$(bench_route "$prof")
  case "$route" in
    lanes)            rdesc="VMM fn-lanes" ;;
    multi-slot)       rdesc="multi-slot ($(bench_slots) слота)" ;;
    singleton-dflash) rdesc="singleton+DFlash" ;;
    *)                rdesc="singleton (serial)" ;;
  esac
  ROUTE="$route"

  log "bench ($mode): профиль $prof | модель $model | роут: $rdesc"
  echo "повторов на сценарий: $RUNS | артефакты: $OUT"

  log "прогрев (1 незамеряемый запрос)"
  bench_payload "$BENCH_TMP/warm.json" "$BENCH_TMP/c_warm.txt" 16
  bench_req "$BENCH_TMP/warm.json" "$BENCH_TMP/warm_resp" 120 >/dev/null || \
    warn "прогрев не удался — цифры первого сценария могут быть занижены"

  log "сценарии quick"
  bench_solo solo-code "$BENCH_TMP/c_code.txt" 400
  MED_SOLO_CODE=$(bench_med solo-code 4 || true)
  bench_solo solo-prose "$BENCH_TMP/c_prose.txt" 400
  bench_ttft

  if [ "$mode" = full ]; then
    log "сценарии full"
    bench_prefill
    bench_longgen
    bench_parallel 2
    bench_parallel 4
    bench_hol
    echo "ar-baseline: пропущен (сравнение спекуляция/нет — через use разных профилей)"
    local med_hol note_hol=""
    med_hol=$(bench_med hol 2 || true)
    if [ -n "$med_hol" ] && [ -n "${BENCH_HOL_REF:-}" ]; then
      note_hol=$(awk -v m="$med_hol" -v r="$BENCH_HOL_REF" 'BEGIN{
        if (r+0 > 0) printf "короткий ждал %.1f c; изоляция %.0f%% (сольный референс %.2f c)",
          (m > r ? m - r : 0), r / m * 100, r }')
    elif [ -n "$med_hol" ]; then
      note_hol="сольный референс не удался — % изоляции не посчитать"
    fi
    [ -n "$note_hol" ] && export B_NOTE_hol="$note_hol" || true
  fi

  if [ -n "${MED_SOLO_CODE:-}" ]; then
    export B_NOTE_prefill_100k="decode 16 tok вычтен (соло-рейт $MED_SOLO_CODE tok/s)"
  else
    export B_NOTE_prefill_100k="decode 16 tok НЕ вычтен (соло-рейт неизвестен)"
  fi

  # ── артефакт, таблица, compare ──
  ts_iso=$(date +%Y-%m-%dT%H:%M:%S%z)
  fname="$(date +%Y-%m-%dT%H%M%S).json"
  base=$(ls -1t "$OUT"/*.json 2>/dev/null | head -1 || true)
  img=$(env_val HIPFIRE_IMAGE); [ -n "$img" ] || img="$IMAGE"
  export B_RUNS="$BENCH_TMP/runs.tsv" B_TS="$ts_iso" B_PROFILE="$prof" B_MODEL="$model"
  export B_ROUTE="$route" B_IMAGE="$img" B_MD5="$md5_real"
  if [ "$mode" = full ]; then B_FULL=1; else B_FULL=0; fi
  export B_FULL
  python3 "$BENCH_TMP/bench_py.py" artifact > "$BENCH_TMP/artifact.json"
  cp "$BENCH_TMP/artifact.json" "$OUT/$fname"
  artifact=$(cat "$BENCH_TMP/artifact.json")

  python3 "$BENCH_TMP/bench_py.py" report
  echo
  if [ -n "$compare" ]; then
    if [ "$compare" = "auto" ]; then
      if [ -n "$base" ]; then
        B_ARTIFACT="$artifact" python3 "$BENCH_TMP/bench_py.py" compare "$base"
      else
        echo "первый прогон — бейслайн (в $OUT нет прошлых json)"
      fi
    else
      [ -f "$compare" ] || die "нет файла сравнения: $compare"
      B_ARTIFACT="$artifact" python3 "$BENCH_TMP/bench_py.py" compare "$compare"
    fi
  fi
  echo
  echo "артефакт: $OUT/$fname"
  echo "повторное сравнение: hfctl bench --compare $OUT/$fname"
  [ "$json_out" = 1 ] && printf '%s\n' "$artifact" >&4
  return 0
}

cmd_uninstall() {
  local purge_models=0 purge_image=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge-models) purge_models=1; shift ;;
      --purge-image)  purge_image=1; shift ;;
      --yes)          ASSUME_YES=1; shift ;;
      *) die "неизвестный флаг uninstall: $1 (доступны: --purge-models --purge-image --yes)" ;;
    esac
  done
  echo "uninstall снимет: контейнеры, сеть проекта, state-каталоги $STATE_BASE"
  echo "(конфиг/disk-тир кэша/kernels на профиль) + legacy-вольюмы,"
  echo "юниты+таймер автозапуска, limits.d, каталог стека $STACK_DIR (включая hfctl)."
  echo "Модели $MODELS_DIR: $([ "$purge_models" = 1 ] && echo 'УДАЛЯЮТСЯ (--purge-models)' || echo 'СОХРАНЯЮТСЯ (переезжают в стеке)')"
  echo "Образ $IMAGE: $([ "$purge_image" = 1 ] && echo 'УДАЛЯЕТСЯ (--purge-image)' || echo 'остаётся (--purge-image — удалить)')"
  echo "Не трогаем: podman, группа render, чужие каталоги."
  ask "Продолжить? [y/N] " || { echo "отменено"; exit 0; }
  cmd_off || true
  ( cd "$STACK_DIR" 2>/dev/null && compose down 2>&1 | tail -2 ) || true
  podman volume rm hipfire_hipfire-config hipfire_hipfire-kernels 2>/dev/null || true
  # модели живут в базе (models/<сет>/ на ВСЕ сеты!) — при сохранении
  # переезжает БАЗА целиком: иначе rm -rf $STACK_DIR сносит чужие сеты
  keep=""
  if [ "$purge_models" != 1 ] && [ -d "$MODELS_BASE" ]; then
    keep="$STACK_DIR.hfctl-models-$$"
    mkdir -p "$(dirname "$keep")"
    mv "$MODELS_BASE" "$keep"
  fi
  rm -rf "$STACK_DIR"
  if [ -n "$keep" ]; then mkdir -p "$(dirname "$MODELS_BASE")"; mv "$keep" "$MODELS_BASE"; fi
  if [ -f /etc/security/limits.d/99-hipfire-memlock.conf ]; then
    sudo rm -f /etc/security/limits.d/99-hipfire-memlock.conf
  fi
  if [ "$purge_models" = 1 ]; then echo "модели удалены"; fi
  if [ "$purge_image" = 1 ];  then podman rmi "$IMAGE" 2>/dev/null || true; echo "образ удалён"; fi
  echo "uninstall DONE"
}

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)      cmd_install "$@" ;;
  use)          cmd_use "$@" ;;
  on)           cmd_on ;;
  off)          cmd_off ;;
  status)       cmd_status "$@" ;;
  logs)         cmd_logs "$@" ;;
  watch)        cmd_watch "$@" ;;
  doctor)       cmd_doctor ;;
  models)       cmd_models ;;
  pull)         cmd_pull "$@" ;;
  bench)        cmd_bench "$@" ;;
  up)           cmd_up ;;          # скрытый алиас
  down)         cmd_down ;;        # скрытый алиас
  mode)         cmd_mode "$@" ;;   # скрытый алиас
  autostart)    cmd_on ;;          # скрытый алиас
  noautostart)  cmd_off ;;         # скрытый алиас
  _watchdog)    cmd_watchdog ;;
  _boot)        cmd_boot ;;
  uninstall)    cmd_uninstall "$@" ;;
  "")           usage ;;
  *)            echo "неизвестная команда '$cmd'. Команды: install | use <profile> | status [--json] | logs | watch | on | off | doctor | models | pull <profile> | bench [full] | uninstall" \
                  " (алиасы: up|down|mode|autostart|noautostart). Профили: $PROFILE_LIST" >&2; exit 1 ;;
esac
